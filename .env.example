# ============================================================
# CTO Watch — ملف الإعدادات (نسخة مثال)
# طريقة الاستخدام: انسخ الملف ده لـ .env واملا المفاتيح المطلوبة
#   Copy-Item .env.example .env
# سطور # دي شروحات فقط ومش بتأثر على التشغيل.
# أي قيمة فيها your_..._here لازم تتملي بمفتاح حقيقي قبل التشغيل.
# ============================================================

# ---------- GitHub: مراقبة الـ Pull Requests ----------
# توكن GitHub بصلاحية قراءة الريبو — من غيره مفيش PRs هتيجي.
# بيطلع من: GitHub Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=your_github_token_here
# الريبو المراقب بصيغة owner/repo
GITHUB_REPO=SeifMahmoud63/CTO-Copilot
# عنوان GitHub API (ثابت غالبا، مش هتحتاج تغيره)
GITHUB_API_URL=https://api.github.com
# كل كام ثانية نسأل GitHub عن PRs جديدة (التلخيص التلقائي يعتمد عليه)
GITHUB_POLL_INTERVAL_SECONDS=30
# الـ SLA: بعد كام يوم الـ PR المفتوح يعتبر متأخر (overdue)
PR_STALE_THRESHOLD_DAYS=5

# ---------- Bedrock: المخ الأساسي للتلخيص ----------
# مفتاح Bedrock Mantle — المصدر الأول لتوليد ملخصات الـ PRs
BEDROCK_API_KEY=your_bedrock_api_key_here
# عنوان واجهة Bedrock المتوافقة مع OpenAI
BEDROCK_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/openai/v1
# عنوان واجهة Qwen (التلخيص شغال عليها فعليا)
BEDROCK_BASE_URL_QWEN=https://bedrock-mantle.us-west-2.api.aws/v1
# موديل الصور (للتوسعات الجاية زي تحليل صور الـ UI في الـ PRs)
BEDROCK_VISION_MODEL=us.amazon.nova-pro-v1:0
# موديل التلخيص الأساسي
BEDROCK_MODEL=qwen.qwen3-32b
# هوية AWS (احتياطية لبعض الاستدعاءات)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# منطقة AWS
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# ---------- JEV: تقييم الـ Impact من 1 لـ 10 ----------
# مفتاح TypeSafe JEV — بيقيّم الأثر المعماري لكل PR.
# لو ناقص، السكور بيبقى 5 محايد والسيستم بيكمل عادي
JEV_API_KEY=your_jev_api_key_here
# عنوان خدمة JEV للقرارات
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# اسم الموديل المستخدم في التقييم
JEV_MODEL=jev-latest

# ---------- Groq: خطة الطوارئ لما Bedrock يقع ----------
# مفتاح Groq — بيشتغل تلقائيا كبديل لما الـ circuit breaker يفتح
GROQ_API_KEY=your_groq_api_key_here
# موديل الطوارئ الأول
GROQ_MODEL=openai/gpt-oss-20b
# موديل الطوارئ الاحتياطي (لو الأول فشل)
GROQ_BACKUP_MODEL=openai/gpt-oss-120b

# ---------- Hyperparameters: أسلوب كتابة الموديل ----------
# درجة الإبداع (0.2 = رزين ودقيق، مناسب لملخصات إدارية)
LLM_TEMPERATURE=0.2
# أقصى طول للملخص الواحد بالتوكن
LLM_MAX_TOKENS=1024

# ---------- Circuit Breaker: الحماية من سقوط Bedrock ----------
# مدة حظر Bedrock بالثواني بعد ما يفشل قبل ما نجربه تاني (1800 = نص ساعة)
CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800
# رسالة اختبار الحياة الخفيفة اللي بتتبعت بعد نهاية الحظر
CIRCUIT_BREAKER_PROBE_PROMPT=ping

# ---------- Application Server: تشغيل الأبلكيشن ----------
# عنوان الاستماع (0.0.0.0 يعني متاح من بره الكونتينر)
APP_HOST=0.0.0.0
# بورت الواجهة والـ API
APP_PORT=8000
# فولدر ملفات الواجهة (HTML/CSS/JS)
STATIC_DIR=web

# ---------- MySQL: قاعدة البيانات ----------
# اسم هوست الداتابيز — كلمة mysql هنا اسم الكونتينر جوه شبكة الدوكر،
# ومن الـ terminal بتاعك استخدم 127.0.0.1 مع بورت 3307 بدلها
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cto_user
MYSQL_PASSWORD=cto_password_2026
MYSQL_DATABASE=cto_copilot_db
# باسورد الـ root بتاعة إيمدج MySQL نفسها (بيستخدمها الكونتينر أول تشغيل)
MYSQL_ROOT_PASSWORD=cto_root_password_2026
# لو فاضية بيتبني تلقائيا من القيم اللي فوق — املاها بس لو عندك داتابيز خارجية
DATABASE_URL=

# ---------- Chatbot Agent: ذاكرة الشات ----------
# الشات بيفتكر كام رسالة ورا وهو بيرد (نافذة الذاكرة قصيرة المدى)
CHAT_MEMORY_WINDOW_SIZE=10
# بيبص على كام رسالة ورا عشان يفهم المتابعات زي "التانيه" دي مين
CHAT_QUERY_REWRITE_WINDOW_SIZE=2

# ---------- Celery: المهام الخلفية (Redis) ----------
# عنوان Redis كوسيط لتشغيل المهام الخلفية
CELERY_BROKER_URL=redis://redis:6379/0
# مكان تخزين نتائج المهام (polling حالة توليد التقارير يعتمد عليه)
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------- Daily CTO Report: التقرير اليومي المجدول ----------
# المنطقة الزمنية لحساب ميعاد التقرير
REPORT_TIMEZONE=Africa/Cairo
# ساعة توليد التقرير (8 الصبح)
REPORT_HOUR=8
# دقيقة توليد التقرير
REPORT_MINUTE=0
# فولدر حفظ ملفات الـ PDF المولدة
REPORTS_DIR=reports
# لغة التقرير (English فقط عشان الـ PDF يطلع نضيف من غير مشاكل اتجاه النص)
REPORT_LANGUAGE=English

# ---------- Deepgram: وكيل الصوت الحي ----------
# مفتاح Deepgram — لو ناقص فيتشر الصوت بتتقفل بأدب من غير ما تكسر حاجة
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# موديل السمع (تحويل الكلام لنص)
DEEPGRAM_AGENT_MODEL=nova-3
# الصوت المستخدم في الرد (صوت نسائي إنجليزي)
DEEPGRAM_VOICE_MODEL=aura-asteria-en
# عنوان خدمة الوكيل الصوتي (اتصال WebSocket مباشر)
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse

# ---------- Access Gate: بوابة الدخول (باسورد + Google Authenticator) ----------
# باسورد الدخول المشتركة — لازم تتغير لقيمة قوية قبل أي نشر
CTO_PASSWORD=change_me_to_a_strong_password
# مفتاح تشفير الجلسات — ولّده بالأمر ده ومحدش يعرفه غيرك:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=generate_with_python_secrets_token_urlsafe_32
# الجلسة تعيش كام ساعة قبل ما تطلب دخول من جديد
SESSION_MAX_AGE_HOURS=12
# اختيار "افتكر الجهاز" يفضل ساري كام يوم
REMEMBER_ME_DAYS=7
# الاسم اللي بيظهر جنب الكود في تطبيق Google Authenticator
TOTP_ISSUER=CTO-Copilot
# عدد المحاولات الغلط المسموحة قبل القفل
AUTH_MAX_ATTEMPTS=3
# مدة قفل الـ IP بالثواني بعد تخطي المحاولات (1800 = نص ساعة)
AUTH_LOCKOUT_SECONDS=1800
