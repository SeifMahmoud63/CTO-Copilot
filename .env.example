# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=SeifMahmoud63/CTO-Copilot
GITHUB_API_URL=https://api.github.com
GITHUB_POLL_INTERVAL_SECONDS=30

# AWS / Bedrock Configuration
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/openai/v1
BEDROCK_BASE_URL_QWEN=https://bedrock-mantle.us-west-2.api.aws/v1
BEDROCK_VISION_MODEL=us.amazon.nova-pro-v1:0
BEDROCK_MODEL=qwen.qwen3-32b
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# JEV Decision Model Configuration
JEV_API_KEY=your_jev_api_key_here
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Groq Fallback Configuration
GROQ_API_KEY=your_groq_api_key_here

GROQ_MODEL=openai/gpt-oss-20b
GROQ_BACKUP_MODEL=openai/gpt-oss-120b

# Hyperparameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Circuit Breaker Configuration (1800 seconds = 30 minutes)
CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800
CIRCUIT_BREAKER_PROBE_PROMPT=ping

# Application Server
APP_HOST=0.0.0.0
APP_PORT=8000
STATIC_DIR=web

# MySQL Async Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cto_user
MYSQL_PASSWORD=cto_password_2026
MYSQL_DATABASE=cto_copilot_db
MYSQL_ROOT_PASSWORD=cto_root_password_2026
DATABASE_URL=
