# ============================================================
# CTO Watch — Environment Configuration Template
# Usage: Copy this file to .env and fill in required values:
#   cp .env.example .env
# ============================================================

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=SeifMahmoud63/CTO-Copilot
GITHUB_API_URL=https://api.github.com
GITHUB_POLL_INTERVAL_SECONDS=30
PR_STALE_THRESHOLD_DAYS=5

# Bedrock (Primary Summarization)
BEDROCK_API_KEY=your_bedrock_api_key_here
BEDROCK_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/openai/v1
BEDROCK_BASE_URL_QWEN=https://bedrock-mantle.us-west-2.api.aws/v1
BEDROCK_VISION_MODEL=us.amazon.nova-pro-v1:0
BEDROCK_MODEL=qwen.qwen3-32b
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# JEV Decision Model (Impact & Urgency Scoring 1-10)
JEV_API_KEY=your_jev_api_key_here
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Gemini (chatbot actor only — judge/summaries stay on Bedrock)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.1-pro-preview
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# Chatbot backend: gemini | bedrock
CHAT_PROVIDER=gemini

# Groq (Fallback Chain + judge fallback endpoint)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BACKUP_MODEL=openai/gpt-oss-120b

# Hyperparameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Reasoning effort for the chat actor: low/medium/high or empty (= default).
# Low is ~3x faster on reasoning models with quality intact (measured live).
LLM_REASONING_EFFORT=high

# Circuit Breaker
CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800
CIRCUIT_BREAKER_PROBE_PROMPT=ping

# Application Server
APP_HOST=0.0.0.0
APP_PORT=8000
STATIC_DIR=web

# MySQL Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=cto_user
MYSQL_PASSWORD=cto_password_2026
MYSQL_DATABASE=cto_copilot_db
MYSQL_ROOT_PASSWORD=cto_root_password_2026
DATABASE_URL=

# Chatbot Agent
CHAT_MEMORY_WINDOW_SIZE=10
CHAT_QUERY_REWRITE_WINDOW_SIZE=2
# SSE token streaming for chat replies (Server-Sent Events).
# Runtime toggle lives in Eval Lab (POST /api/chat/sse); this is only the boot default.
CHAT_SSE_ENABLED=false

# Celery (Redis Broker)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Daily CTO Report (Celery Beat)
REPORT_TIMEZONE=Africa/Cairo
REPORT_HOUR=8
REPORT_MINUTE=0
REPORTS_DIR=reports
REPORT_LANGUAGE=English

# Deepgram Live Voice Agent
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_AGENT_MODEL=nova-3
DEEPGRAM_VOICE_MODEL=aura-asteria-en
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse

# Access Gate (Shared Password + TOTP)
CTO_PASSWORD=change_me_to_a_strong_password
SESSION_SECRET=generate_with_python_secrets_token_urlsafe_32
SESSION_MAX_AGE_HOURS=12
REMEMBER_ME_DAYS=7
TOTP_ISSUER=CTO-Copilot
AUTH_MAX_ATTEMPTS=3
AUTH_LOCKOUT_SECONDS=1800

# LLM-as-a-Judge (Grounding Gate)
JUDGE_ENABLED=true
JUDGE_MODEL=openai.gpt-oss-20b
JUDGE_MAX_TOKENS=1024
# Immediate retries when the judge returns an empty response
JUDGE_RETRIES=1
# Judge fallback runs on GROQ (slash-style ID, different provider from the
# Bedrock primary) so a Bedrock outage doesn't take the fallback with it.
JUDGE_FALLBACK_MODEL=openai/gpt-oss-20b

# Eval Lab concurrency: parallel question groups per run (1 = sequential)
EVAL_MAX_CONCURRENCY=3

# Email Triage (Read-only IMAP)
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_MAILBOX=INBOX
EMAIL_UNREAD_ONLY=true
EMAIL_POLL_INTERVAL_MINUTES=3
EMAIL_MAX_BODY_CHARS=4000

# Slack Bot Integration (SLA alerts & daily PDF report uploads)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# ---------- S3 storage: all files live here (nothing on local disk) ----------
# MinIO Web Console UI: http://localhost:9001
# User: cto-minio-admin | Password: change_me_to_a_very_strong_38char_password_X7k9!
# S3 API: http://localhost:9000 (or 9090) | inside compose: http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=cto-minio-admin
MINIO_SECRET_KEY=change_me_to_a_very_strong_38char_password_X7k9!
MINIO_BUCKET_REPORTS=cto-reports
MINIO_BUCKET_MLFLOW=mlflow-artifacts
MINIO_BUCKET_PROGRESS=eval-progress
MINIO_SECURE=false

# ---------- Eval Lab: hallucination-test result tracking ----------
# Production: MySQL (separate mlflow_db database — sharing the app database breaks both sides) + S3 storage.
# MLFLOW_TRACKING_URI=mysql+pymysql://cto_user:cto_password_2026@mysql:3306/mlflow_db
# MLFLOW_S3_ENDPOINT_URL=http://localhost:9000 (or http://minio:9000 inside compose)
# For quick local experiments without Docker, SQLite can be used:
# MLFLOW_TRACKING_URI=sqlite:///./mlruns/mlflow.db
MLFLOW_TRACKING_URI=mysql+pymysql://cto_user:cto_password_2026@mysql:3306/mlflow_db
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
